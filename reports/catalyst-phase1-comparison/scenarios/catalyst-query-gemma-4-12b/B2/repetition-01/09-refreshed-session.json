          "parentVersionId": null,
          "ordinal": 1,
          "authorType": "model",
          "sql": "SELECT \n  t1.patient_id, \n  t1.family_name, \n  t1.given_name, \n  t2.value_coded_name \nFROM analytics.hiv_patient_dim_v1 AS t1 \nJOIN (\n  SELECT \n    patient_id, \n    value_coded_name, \n    ROW_NUMBER() OVER (PARTITION BY patient_id ORDER BY observed_at DESC) as rank \n  FROM analytics.hiv_observation_fact_v1 \n  WHERE concept_name IN ('Antiretroviral adherence in past week', 'Overall drug adherence in last month') \n    AND value_coded_name IS NOT NULL\n) AS t2 ON t1.patient_id = t2.patient_id \nWHERE t2.rank = 1 \n  AND t2.value_coded_name <> 'All'",
