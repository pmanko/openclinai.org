      "idempotencyKey": "harness-notebook-2a6eef28-3f47-4767-8172-d958301a9160",
      "validationStatus": "valid",
      "query": {
        "sql": "WITH latest_adherence AS (\n  SELECT \n    patient_id, \n    value_coded_name, \n    observed_at, \n    ROW_NUMBER() OVER (PARTITION BY patient_id ORDER BY observed_at DESC) as rank\n  FROM analytics.hiv_observation_fact_v1\n  WHERE concept_name = :adherence_concept\n)\nSELECT \n  p.family_name, \n  p.given_name, \n  la.value_coded_name AS latest_adherence_result\nFROM analytics.hiv_patient_dim_v1 p\nJOIN latest_adherence la ON p.patient_id = la.patient_id\nWHERE la.rank = 1 \n  AND la.value_coded_name != 'All'",
        "parameters": [
          {
            "name": "adherence_concept",
            "type": "string",
            "source": "question",
            "value": "Antiretroviral adherence in past week"
          }
        ]
      },
