      "validationStatus": "valid",
      "query": {
        "sql": "SELECT t1.patient_id, t1.family_name, t1.given_name FROM analytics.hiv_patient_dim_v1 AS t1 JOIN (SELECT DISTINCT ON (patient_id) patient_id, value_coded_name AS latest_adherence FROM analytics.hiv_observation_fact_v1 WHERE concept_name = :concept_name AND obs_status = 'final' ORDER BY patient_id, observed_at DESC) AS t2 ON t1.patient_id = t2.patient_id WHERE t2.latest_adherence <> 'All'",
        "parameters": [
          {
            "name": "concept_name",
            "type": "string",
            "source": "question",
            "value": "Antiretroviral adherence in past week"
          }
        ]
