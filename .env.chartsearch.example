# Local ChartSearchAI configuration
#
# `make local-stack-up` uses these values directly when .env.chartsearch is
# absent. Copy this file only when you need local overrides. Never commit secrets.

# OpenMRS data and UI
OMRS_DB_NAME=openmrs
OPENMRS_REFAPP_TAG=nightly-chartsearch
HARNESS_PROXY_HTTP_PORT=8088
HARNESS_PROXY_HTTPS_PORT=8443

# One product endpoint: ChartSearchAI -> med-agent-hub -> llama.cpp.
# ChartSearchAI does not discover or call the raw model server.
CHARTSEARCH_HUB_ENDPOINT_URL=http://med-agent-hub:8080/v1/chat/completions
CHARTSEARCH_HUB_API_KEY=
MED_AGENT_HUB_PORT=18081
MED_AGENT_LLM_BASE_URL=http://host.docker.internal:8077

# llama.cpp router. The host-native binary is used on macOS so Metal remains
# available. Model files default to ~/.cache/llama-router-models; override with
# an existing directory containing the filenames in scripts/llama-router.ini.
LLAMA_MODEL_DIR=
# Allow the default Gemma 4 12B and one comparison model to stay resident.
LLAMA_ROUTER_MODELS_MAX=2

# Existing synthetic-demo administrator login used by setup and daily startup.
CHARTSEARCH_ADMIN_USER=admin
CHARTSEARCH_ADMIN_PASSWORD=Admin123

# Optional patient-source overrides. Daily startup uses the demo administrator;
# `make med-agent-hub-up` also permits explicit blanks for inline-only use.
QUERYSTORE_BASE_URL=
QUERYSTORE_USERNAME=
QUERYSTORE_PASSWORD=
